<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A full-screen, no-action-bar platform theme; the dark window background avoids a white
         flash while the WebView starts. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
